<Window x:Class="OrderProcessingMembersUI.OrderTicketsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OrderProcessingMembersUI"
        mc:Ignorable="d"
        Title="OrderTicketsWindow" Height="200" Width="350">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" >
            <TextBlock Text="Gebruiker:" Margin="5 0 0 0" VerticalAlignment="Center" FontSize="12"/>
            <TextBox Name="UserNameTextBox" Margin="5" VerticalAlignment="Top" FontSize="12" IsReadOnly="True"/>
        </StackPanel>

        <Button Grid.Row="0" Grid.Column="1" Content="Uitloggen" Click="LogoutButton_Click" Height="30" FontSize="12" VerticalAlignment="Top" Margin="5 5 5 0" Padding="10 0" HorizontalAlignment="center"/>

        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Left" Margin="5">
            <TextBlock Text="Aantal Tickets:" FontSize="12" Margin="5 5"/>
            <TextBox Name="TicketCountTextBox" Width="50" Margin="0 5"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left" Margin="5">
            <TextBlock Text="Event:" FontSize="12" Margin="5 5"/>
            <ComboBox Name="EventComboBox" Width="150" Margin="0 5"/>
        </StackPanel>

        <Button Grid.Row="2" Grid.ColumnSpan="2" Height="40" Width="340" Content="Bestel Tickets" Click="OrderTicketsButton_Click"  FontSize="12"  Margin="5 10 5 5" Padding="10 0" HorizontalAlignment="Center"/>

    </Grid>
</Window>
