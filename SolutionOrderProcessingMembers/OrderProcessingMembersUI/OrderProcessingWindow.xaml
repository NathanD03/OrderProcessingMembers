<Window x:Class="OrderProcessingMembersUI.OrderProcessingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OrderProcessingMembersUI"
        mc:Ignorable="d"
        Title="OrderProcessingWindow" Height="450" Width="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Grid.Column="0" Content="Process Orders" Margin="5"/>

        <ListBox Grid.Row="1" Grid.Column="0" Name="OrdersListBox" Margin="5" />
        <ListBox Grid.Row="2" Grid.Column="0" Name="ServicesListBox" Margin="5" />
        <ListBox Grid.Row="3" Grid.Column="0" Name="DeliveryListBox" Margin="5" />
    </Grid>
</Window>
