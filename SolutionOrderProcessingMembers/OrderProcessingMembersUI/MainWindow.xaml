<Window x:Class="OrderProcessingMembersUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OrderProcessingMembersUI"
        mc:Ignorable="d"
        Title="Log In" Height="75" Width="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="0" Grid.Row="0" Text="Naam:" Margin="0,0,0,5" VerticalAlignment="Center" FontSize="12"/>
        <TextBox Grid.Column="1" Grid.Row="0" Name="NameTextBox" Margin="0,0,0,5" Height="20" VerticalAlignment="Center" />
        <Button Grid.Column="2" Grid.Row="0" Content="Inloggen" Click="SubmitButton_Click" Height="20" FontSize="12" VerticalAlignment="Center" Margin="5 0 5 5"  Padding="10 0" HorizontalAlignment="center"/>
        <CheckBox Grid.Column="3" Grid.Row="0" Name="IsAdminCheckBox" Content="Admin" VerticalAlignment="Top" Margin="5,0,5,0"/>
    </Grid>
</Window>
